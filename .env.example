# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file — it is excluded by .gitignore.

# ── LLM / AI ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
MOONDREAM_KEY=your_moondream_api_key_here

# ── Vector Store (Pinecone) ───────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_API_KEY_PHRAMACY=your_pharmacy_pinecone_api_key_here

# ── Web Search ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith Tracing (Optional) ──────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=MedNexus-AI

# ── Web Application & Auth ────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
